{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2">
  <a href="https://github.com/{{ include.repository }}" class="text-decoration-none">
    <div class="card h-100 p-3">
      <h6 class="mb-1">
        <i class="fab fa-github"></i>
        {% if show_owner %}{{ repo_url[0] }}/{% endif %}<strong>{{ repo_url[1] }}</strong>
      </h6>
    </div>
  </a>
</div>
